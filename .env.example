# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=
# optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=
DATABASE_URL=postgres://localhost/iow_dev
# set to "mock" to run the worker without the model (used by the e2e suite)
WORKER_MODEL=
# "vision" skips tesseract and transcribes scans with the model (used on Vercel)
OCR_ENGINE=
